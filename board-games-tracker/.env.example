## Docker Compose settings. Local development uses the application URLs below.
APP_URL=http://localhost:12500
APP_PORT=12500
# The host address the app port is published on. The default keeps it reachable
# only from this machine, so clients must go through the reverse proxy. Use
# 0.0.0.0 only when the proxy runs on another host, and firewall the port.
APP_BIND_ADDRESS=127.0.0.1
POSTGRES_DB=board_games_tracker
POSTGRES_USER=board_games_tracker
# Use a URL-safe random password because Compose embeds it in DATABASE_URL.
POSTGRES_PASSWORD=replace-with-a-random-url-safe-password
POSTGRES_VOLUME_NAME=board_games_tracker_data
# The backup service writes a database dump into BACKUP_DIRECTORY every
# BACKUP_INTERVAL_DAYS days and keeps the newest BACKUP_KEEP dumps.
BACKUP_DIRECTORY=./backups
BACKUP_INTERVAL_DAYS=7
BACKUP_KEEP=8
SEARXNG_SECRET=replace-with-another-random-secret

DATABASE_URL=postgresql://board_games_tracker:board_games_tracker@localhost:5432/board_games_tracker
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:12500
NEXT_PUBLIC_APP_URL=http://localhost:12500
# Any successful registration matching ADMIN_EMAIL becomes an administrator.
# Unset this after bootstrap, especially before setting ALLOW_SIGN_UP=true.
ADMIN_EMAIL=
ALLOW_SIGN_UP=false
# Optional: when set, /api/health requires Authorization: Bearer <token>.
HEALTH_CHECK_TOKEN=
# Optional: comma-separated addresses or CIDR ranges of the reverse proxies in
# front of the app. Set it when more than one proxy or CDN hop adds to
# X-Forwarded-For, so rate limits key on the real client instead of one shared
# bucket. Leave it empty with a single proxy that overwrites the header.
TRUSTED_PROXIES=
LOG_LEVEL=info
SEARXNG_URL=http://127.0.0.1:8080
# Optional: Sentry-compatible error tracking (e.g. a self-hosted Bugsink instance).
# Leave unset to disable error reporting.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Builds use the version in package.json for Bugsink and GitHub Releases.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
# Keeps Server Action identifiers stable across rebuilds, so a browser tab left
# open over a deployment keeps working instead of failing with "Failed to find
# Server Action". Required when several application instances serve one origin.
# Generate with: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
# Optional transactional SMTP. Email verification and recovery are enabled only
# when both SMTP_HOST and SMTP_FROM_EMAIL are set. Use port 465 with
# SMTP_SECURE=true, or port 587 with SMTP_SECURE=false and SMTP_REQUIRE_TLS=true.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Board Games Tracker
SMTP_FROM_EMAIL=
SMTP_REPLY_TO=
# Optional build-only source-map upload settings for Bugsink. SENTRY_PROJECT is
# the Bugsink project slug; SENTRY_AUTH_TOKEN_FILE points to an untracked file
# containing a Bugsink API token. The organization sentinel is Bugsink's default.
SENTRY_URL=
SENTRY_ORG=bugsinkhasnoorgs
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN_FILE=.sentry-auth-token.disabled
