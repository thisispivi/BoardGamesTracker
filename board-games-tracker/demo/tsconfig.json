{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@package": ["../package.json"],
      "@/*": ["../src/*"],
      "@messages/*": ["../messages/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
