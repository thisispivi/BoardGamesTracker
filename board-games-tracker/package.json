{
  "name": "board-games-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "A secure, self-hosted board-game collection and game-night picker.",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.18.0",
    "pnpm": ">=11.21.0"
  },
  "scripts": {
    "dev": "next dev --port 12500",
    "build": "next build",
    "bugsink:test": "node --env-file-if-exists=.env.local scripts/test-bugsink.mjs",
    "start": "next start --port 12500",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write . \"../*.md\" ../.github",
    "format:check": "prettier --check . \"../*.md\" ../.github",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "knip": "knip",
    "check": "run-p typecheck lint format:check test knip",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "images:cache": "node --env-file-if-exists=.env.local --import tsx scripts/cache-game-images.ts",
    "prepare": "cd .. && husky board-games-tracker/.husky"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@sentry/nextjs": "^10.72.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "better-auth": "^1.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "csv-parse": "^7.0.2",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "fuse.js": "^7.5.0",
    "lucide-react": "^1.40.0",
    "motion": "^13.2.0",
    "next": "16.3.4",
    "next-intl": "^4.14.2",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.1.1",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-circle-flags": "^0.0.30",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "stopword": "^3.1.5",
    "tailwind-merge": "^3.6.0",
    "yauzl": "3.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@sentry/node": "^10.72.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/stopword": "^2.0.3",
    "@types/yauzl": "^3.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.4",
    "eslint-plugin-jsdoc": "^64.3.4",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "knip": "^6.34.0",
    "lint-staged": "^17.4.1",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": "prettier --write"
  }
}
