DATABASE_URL=postgresql://board_games_tracker:board_games_tracker@localhost:5432/board_games_tracker
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:12500
NEXT_PUBLIC_APP_URL=http://localhost:12500
# Any successful registration matching ADMIN_EMAIL becomes an administrator.
# Unset this after bootstrap, especially before setting ALLOW_SIGN_UP=true.
ADMIN_EMAIL=
ALLOW_SIGN_UP=false
# Optional: when set, /api/health requires Authorization: Bearer <token>.
HEALTH_CHECK_TOKEN=
LOG_LEVEL=info
SEARXNG_URL=http://127.0.0.1:8080
